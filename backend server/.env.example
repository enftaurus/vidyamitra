# =============================================================================
# VidyaMitra — Backend Environment Variables
# Copy this file to .env and fill in real values.
# =============================================================================

# ---------------------------------------------------------------------------
# Supabase (PostgreSQL)
# Get these from: https://supabase.com → Project Settings → API
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-service-role-key

# ---------------------------------------------------------------------------
# Groq LLM API (used for resume tailoring, roadmap generation, chatbot)
# Get your key at: https://console.groq.com
# ---------------------------------------------------------------------------
GROQ_API_KEY=your-groq-api-key

# ---------------------------------------------------------------------------
# Deepgram STT (Speech-to-Text for interview voice input)
# Get your key at: https://console.deepgram.com
# ---------------------------------------------------------------------------
DEEP_API=your-deepgram-api-key

# ---------------------------------------------------------------------------
# Codeforces API (for coding profile analytics)
# App credentials from: https://codeforces.com/settings/api
# ---------------------------------------------------------------------------
CF_API=your-codeforces-api-key
CF_SECRET=your-codeforces-api-secret

# ---------------------------------------------------------------------------
# AssemblyAI STT (optional alternate speech-to-text)
# ---------------------------------------------------------------------------
APP_ID=your-assemblyai-app-id
APP_KEY=your-assemblyai-app-key

# ---------------------------------------------------------------------------
# Session Security
# Generate a strong random string: python3 -c "import secrets; print(secrets.token_hex(32))"
# ---------------------------------------------------------------------------
SESSION_SECRET=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# CORS — comma-separated list of allowed frontend origins
# Default covers Vite dev server. Add your production domain here.
# ---------------------------------------------------------------------------
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ---------------------------------------------------------------------------
# Redis (required for queue locks, session state, leaderboard)
# Default assumes Redis running locally on standard port.
# For remote Redis: redis://username:password@host:port/0
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
